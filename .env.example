# 飞书监听配置
FEISHU_APP_ID=APP_ID_PLACEHOLDER
FEISHU_APP_SECRET=APP_SECRET_PLACEHOLDER
TARGET_CHAT_IDS=CHAT_ID_PRIMARY,CHAT_ID_SECONDARY
PUSH_CHAT_ID=CHAT_ID_NOTIFICATION

# 仅作为“飞书消息分类器”的旧版兜底配置。
# 正常情况下，各 Dify 应用请在网页「Dify 应用管理」中分别配置。
DIFY_API_BASE=https://dify.example.com/v1
DIFY_API_KEY=DIFY_API_KEY_PLACEHOLDER
DIFY_WORKFLOW_NAME=WORKFLOW_NAME_PLACEHOLDER
DIFY_WORKFLOW_MODULE_KEY=feishu_message_router

# 平台登录与权限
# 正式部署前必须修改为长度足够的随机字符串。
APP_ENV=demo
APP_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_JWT_TTL_SECONDS=28800
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123   # 仅用于测试，正式部署时请修改为安全的密码。
APP_CORS_ORIGINS=http://localhost:5173
EMPLOYEE_CSV_PATH=data/employee_info.csv
